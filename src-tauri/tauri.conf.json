{
  "productName": "rosweb",
  "version": "0.1.0",
  "identifier": "com.rosweb.app",
  
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../build"
  },
  
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "ROSWeb",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:8000 ws://localhost:8000; connect-src 'self' http://localhost:8000 ws://localhost:8000; img-src 'self' data: http://localhost:8000"
    }
  },
  
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": []
  },
  
  "plugins": {
    "allowlist": {
      "all": false,
      "http": {
        "all": true,
        "request": true,
        "scope": ["http://localhost:8000/**", "http://127.0.0.1:8000/**"]
      }
    }
  }
}